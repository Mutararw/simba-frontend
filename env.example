# --- BACKEND CONNECTION ---
# The URL where your API/backend is hosted.
# Leave empty when the frontend and backend are served from the same origin.
# For local development: http://localhost:5000
# For production: https://simba-server.onrender.com
VITE_API_URL=

# --- FRONTEND CONFIGURATION ---
# Your frontend's own URL (used for social login redirects)
# For local development: http://localhost:8080
# For production: https://www.yourdomain.com
VITE_CLIENT_URL=http://localhost:8080

# --- ROUTING MODE ---
# Use "hash" if your host does not support SPA rewrites.
VITE_ROUTER_MODE=browser

# --- FEATURE FLAGS (Optional) ---
# Set to 'true' to enable detailed auth logging in the console
VITE_DEBUG_AUTH=false
